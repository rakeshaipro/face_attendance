# Copy to .env and fill in. All variables use the FA_ prefix.

# --- Hosting ---------------------------------------------------------
FA_HOST=0.0.0.0
FA_PORT=8000

# --- Security --------------------------------------------------------
# Fernet key for encrypting camera stream credentials (§3.13.9).
# Generate one with:  python -m app.cli gen-encryption-key
FA_ENCRYPTION_KEY=

# --- Database --------------------------------------------------------
# Defaults to ./data/face_attendance.db (SQLite, per SRS §5).
# FA_DATABASE_URL=sqlite:///./data/face_attendance.db

# --- Recognition engine ---------------------------------------------
# Set to false during development / tests, or when no camera is connected.
FA_AUTOSTART_ENGINE=true
